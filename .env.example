# ── 基础 ──────────────────────────────────────────────
# 数据目录（SQLite 数据库、加密密钥都放这里，务必做持久化）
DATA_DIR=/data

# 监听端口
PORT=8971

# 访问口令。留空表示不鉴权，仅建议在可信内网使用
APP_PASSWORD=

# 数据库连接串。默认 SQLite，也可指向 PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pass@host/db

# ── 拓竹账号 ──────────────────────────────────────────
# china = 中国大陆（api.bambulab.cn / cn.mqtt.bambulab.com）
# global = 海外（api.bambulab.com / us.mqtt.bambulab.com）
BAMBU_REGION=china

# ── 本地体验 ──────────────────────────────────────────
# 设为 1 时不用拓竹账号，用模拟打印机跑通全部流程
BAMBU_MOCK=0
# BAMBU_MOCK_SERIAL=01S00A0000000000

# ── 扣重行为 ──────────────────────────────────────────
# 云端任务历史轮询间隔（秒）
TASK_POLL_INTERVAL=60
# 任务结束后，回查多长时间内的云端记录
TASK_MATCH_WINDOW_MINUTES=20
# 打印失败的任务是否按进度比例扣重
DEDUCT_ON_FAILURE=true
# 进度低于该百分比视为误触，不生成记录
MIN_PROGRESS_TO_RECORD=1.0

# ── 通知 ──────────────────────────────────────────────
# 任意接收 POST {"title":..,"message":..} 的地址
# NOTIFY_WEBHOOK=https://ntfy.sh/你的主题

# ── 高级 ──────────────────────────────────────────────
# 令牌剩余不足多少小时时尝试用保存的密码自动续期
TOKEN_RENEW_BEFORE_HOURS=3
# 云 MQTT 保活秒数
BAMBU_MQTT_KEEPALIVE=30
